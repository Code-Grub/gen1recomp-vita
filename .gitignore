# Downloaded toolchains, SDK packages, mod releases and the ROM. Everything
# here is fetched (and SHA-256 checked) by the build scripts, and some of it
# must never be redistributed: the PowerVR driver modules are Sony/Imagination
# blobs, and red.gb is a game dump.
vendor/

# Build output: VPKs, game.love, bytecode, screenshots, run logs.
build/

__pycache__/
*.pyc

# Never, under any circumstances.
*.gb
*.gbc
*.sav
*.vpk
*.self
*.velf
*.love
*.suprx

# native probe build artifacts (the .c is the source of record)
native/*.elf
native/*.velf
native/*.velf.tmp
native/*.self
native/eboot.bin
native/vpk/
