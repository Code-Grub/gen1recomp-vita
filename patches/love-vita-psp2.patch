+// SDL's vitaGL backend calls vglInitExtended but never sets up the runtime
+// GLSL compiler, so the first shader LOVE compiles reaches an uninitialised
+// vitaShaRK and takes the process down right after the GL context is created.
+// This must run before SDL brings the video subsystem up.
+static void vita_setup_shader_compiler()
+{
+	// Start each run with an empty graphics trace, so a stale file from an
+	// earlier build cannot be mistaken for this run's output.
+	FILE *f = fopen("ux0:data/g1r-gfx.txt", "w");
+	if (f)
+		fclose(f);
+
+	// LuaJIT gets its executable pages from sceKernelAllocMemBlockForVM, and
+	// on hardware every trace aborts with "failed to allocate mcode memory"
+	// no matter how small the request, which points at the app simply having
+	// no memory left. Report what is actually free, and try the same kind of
+	// allocation LuaJIT makes, so the cause is a measurement and not a guess.
+	FILE *m = fopen("ux0:data/g1r-mem.txt", "w");
+	if (m)
+	{
+		SceKernelFreeMemorySizeInfo info;
+		memset(&info, 0, sizeof(info));
+		info.size = sizeof(info);
+		int res = sceKernelGetFreeMemorySize(&info);
+		fprintf(m, "sceKernelGetFreeMemorySize -> 0x%08X\n", res);
+		fprintf(m, "free LPDDR2 (main)  %d bytes (%.1f MB)\n",
+			info.size_user, info.size_user / 1048576.0);
+		fprintf(m, "free CDRAM          %d bytes (%.1f MB)\n",
+			info.size_cdram, info.size_cdram / 1048576.0);
+		fprintf(m, "free phycont        %d bytes (%.1f MB)\n",
+			info.size_phycont, info.size_phycont / 1048576.0);
+		fprintf(m, "newlib heap reserved %d MB, libc heap 16 MB\n", LOVE_VITA_HEAP_MB);
+
+		// Whether the pool reserved ahead of the heap actually landed inside
+		// the branch range LuaJIT needs. This is the whole test: if the delta
+		// is under 14 MB, traces can compile.
+		uintptr_t code = (uintptr_t) (void *) &vita_setup_shader_compiler;
+		fprintf(m, "code address        0x%08X\n", (unsigned) code);
+		if (g1r_jit_pool_base)
+		{
+			intptr_t delta = (intptr_t) ((uintptr_t) g1r_jit_pool_base - code);
+			fprintf(m, "jit pool            0x%08X  %d MB  delta %+.1f MB  %s\n",
+				(unsigned) (uintptr_t) g1r_jit_pool_base,
+				LOVE_VITA_JIT_POOL_MB, delta / 1048576.0,
+				(delta > -14 * 1048576 && delta < 14 * 1048576) ? "IN RANGE" : "OUT OF RANGE");
+		}
+		else
+		{
+			fprintf(m, "jit pool            NOT RESERVED (0x%08X)\n",
+				(unsigned) g1r_jit_pool_err);
+		}
+
+		// Why trace assembly is ~28 KB/s here (measured: ~128 KB of machine
+		// code per 4.5 s stall, and it is NOT flush storms - the area count
+		// never reaches the ceiling). Two candidates, both settled below, once,
+		// at startup, before Lua exists. Nothing here runs per frame.
+		//
+		//  1. The pool may be uncached. sceKernelAllocMemBlockForVM exists for
+		//     runtime code generation, and the kernel may map it non-cached so
+		//     the instruction side stays coherent. LuaJIT's assembler emits a
+		//     trace backwards with many small writes and then patches it, so
+		//     uncached would cost roughly two orders of magnitude - which is
+		//     the size of the gap. Compared against ordinary heap memory.
+		//  2. LuaJIT's own allocator is switched off on this target
+		//     (lj_arch.h forces LUAJIT_USE_SYSMALLOC for PSP2 and lj_alloc.c
+		//     has no PSP2 backend), so every compiler allocation goes through
+		//     newlib malloc, under a lock the audio workers also take.
+		enum { BENCH_BYTES = 512 * 1024, BENCH_ALLOCS = 20000 };
+		void *heapbuf = malloc(BENCH_BYTES);
+		if (heapbuf && g1r_jit_pool_base)
+		{
+			// Touch both first so neither pays a one-off mapping cost.
+			memset(heapbuf, 0, BENCH_BYTES);
+			memset(g1r_jit_pool_base, 0, BENCH_BYTES);
+
+			// 32-bit stores, which is what an instruction stream is.
+			volatile uint32_t *hp = (volatile uint32_t *) heapbuf;
+			volatile uint32_t *pp = (volatile uint32_t *) g1r_jit_pool_base;
+			const int words = BENCH_BYTES / 4;
+
+			SceUInt64 t0 = sceKernelGetProcessTimeWide();
+			for (int i = 0; i < words; i++) hp[i] = (uint32_t) i;
+			SceUInt64 theap = sceKernelGetProcessTimeWide() - t0;
+
+			t0 = sceKernelGetProcessTimeWide();
+			for (int i = 0; i < words; i++) pp[i] = (uint32_t) i;
+			SceUInt64 tpool = sceKernelGetProcessTimeWide() - t0;
+
+			fprintf(m, "\nwrite 512 KB to heap    %6llu us (%.1f MB/s)\n",
+				theap, theap ? 0.5 / (theap / 1000000.0) : 0.0);
+			fprintf(m, "write 512 KB to jitpool %6llu us (%.1f MB/s)  %.1fx %s\n",
+				tpool, tpool ? 0.5 / (tpool / 1000000.0) : 0.0,
+				theap ? (double) tpool / theap : 0.0,
+				tpool > theap * 4 ? "<-- POOL IS SLOW (uncached?)" : "comparable");
+		}
+		if (heapbuf)
+			free(heapbuf);
+
+		// newlib malloc throughput, the other candidate.
+		{
+			void **keep = (void **) malloc(sizeof(void *) * 256);
+			if (keep)
+			{
+				SceUInt64 t0 = sceKernelGetProcessTimeWide();
+				for (int i = 0; i < BENCH_ALLOCS; i++)
+				{
+					int slot = i & 255;
+					if (keep[slot] && i >= 256) free(keep[slot]);
+					keep[slot] = malloc(48 + (i & 127));
+				}
+				SceUInt64 tm = sceKernelGetProcessTimeWide() - t0;
+				for (int i = 0; i < 256; i++) free(keep[i]);
+				free(keep);
+				fprintf(m, "%d malloc/free pairs  %6llu us (%.2f us each)\n",
+					(int) BENCH_ALLOCS, tm, (double) tm / BENCH_ALLOCS);
+			}
+		}
+		fclose(m);
+	}
+
+	vglSetupRuntimeShaderCompiler(SHARK_OPT_DEFAULT, SHARK_ENABLE, SHARK_ENABLE, SHARK_ENABLE);
+}
