diff --git a/src/modules/thread/LuaThread.cpp b/src/modules/thread/LuaThread.cpp
index d052d31..be837f0 100644
--- a/src/modules/thread/LuaThread.cpp
+++ b/src/modules/thread/LuaThread.cpp
@@ -53,6 +53,36 @@ void LuaThread::threadFunction()
 	lua_State *L = luaL_newstate();
 	luaL_openlibs(L);
 
+#ifdef __vita__
+	// Only one Lua state may run the JIT compiler on this console.
+	//
+	// Measured, by elimination, with vita-probe/build_jitmt.py: a single state
+	// compiling repeatedly is fine (12 flush-and-recompile rounds); three more
+	// states running INTERPRETED alongside it is fine; the moment those states
+	// compile as well, the process dies. What they share is the one mcode
+	// region and the VM domain it lives in, and sceKernelSyncVMDomain - the
+	// instruction-cache flush after writing a trace - acts on a whole memory
+	// block. Upstream got isolation for free by giving every mcode area its own
+	// block; ours all come out of one pool, so one state's flush lands on
+	// memory another state is executing from.
+	//
+	// Turning the JIT off here, rather than letting the allocator refuse, is
+	// deliberate: a state that keeps *trying* to compile and failing is far
+	// slower than one that never tries (3340 ms against 657 ms on the loop this
+	// was measured with). Worker states therefore run interpreted, exactly as
+	// they did before any of this worked, and the main state keeps the JIT.
+	lua_getglobal(L, "jit");
+	if (lua_istable(L, -1))
+	{
+		lua_getfield(L, -1, "off");
+		if (lua_isfunction(L, -1))
+			lua_call(L, 0, 0);
+		else
+			lua_pop(L, 1);
+	}
+	lua_pop(L, 1);
+#endif
+
 #ifdef LOVE_BUILD_STANDALONE
 	luax_preload(L, luaopen_love, "love");
 	luax_require(L, "love");
