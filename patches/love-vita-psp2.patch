+// LuaJIT's machine code has to sit within the reach of an ARM relative branch
+// (+-32 MB, of which LuaJIT uses half) of the interpreter, and it asks the OS
+// for memory at a chosen address to get there. The Vita cannot honour that:
+// sceKernelAllocMemBlockForVM() takes only a name and a size, and the kernel
+// places each block after everything already allocated. Since vitasdk's
+// _init_vita_heap() reserves the whole newlib heap as one block before main()
+// runs, every later block lands past it - measured at +139.6 MB with a 144 MB
+// heap and +26.7 MB with a 20 MB one, both out of range. Every trace then
+// failed with LJ_TRERR_MCODEAL while jit.status() still claimed to be on.
+//
+// The heap being one early block is also the way out: take the code pool
+// first and it lands a few MB from the code segment instead. So this replaces
+// libc's sbrk.o wholesale - all four symbols, or the linker would pull that
+// object back in for the ones we left out - and reserves the pool ahead of
+// the heap. lj_mcode.c carves its areas out of it, which also sidesteps the
+// kernel's refusal to grant VM blocks smaller than 1 MB.
+extern "C" {
+
+void *g1r_jit_pool_base = NULL;
+unsigned int g1r_jit_pool_size = 0;
+// Kept so lj_mcode_sync can flush the instruction cache against the right
+// block. It must not go looking the uid up from an address: the lookup it
+// used to do rounds down to a megabyte, which only ever matched back when
+// each mcode area was its own 1 MB-granular block.
+int g1r_jit_pool_uid = -1;
+int g1r_jit_pool_err = 0;
+static SceKernelLwMutexWork g1r_jit_pool_mutex;
+static int g1r_jit_pool_mutex_ok = 0;
+
+// Several Lua states carve areas out of the one pool - LOVE's audio workers
+// each run their own jit_State - so lj_mcode.c takes this around the free-page
+// bitmap. A LwMutex is the cheap kind and this is contended only while a trace
+// is being compiled.
+void g1r_jit_pool_lock(void)
+{
+	if (g1r_jit_pool_mutex_ok)
+		sceKernelLockLwMutex(&g1r_jit_pool_mutex, 1, 0);
+}
+
+void g1r_jit_pool_unlock(void)
+{
+	if (g1r_jit_pool_mutex_ok)
+		sceKernelUnlockLwMutex(&g1r_jit_pool_mutex, 1);
+}
+
+// --- JIT instrumentation --------------------------------------------------
+//
+// Reporting has to happen from C. Four attempts to write a file from Lua in
+// the running game produced nothing - not from io.open in conf.lua, which
+// provably executes, nor from love.filesystem in an epilogue appended to
+// main.lua. The standalone probes could do it; the game cannot. Every file
+// this port has successfully written (g1r-mem, g1r-gfx, g1r-sdl) was written
+// from here, so this is.
+//
+// What it is measuring: the stalls are irregular and multi-second, and the
+// suspicion is sceKernelSyncVMDomain, the instruction-cache flush after each
+// trace is written. Upstream gave every mcode area its own 1 MB block; ours
+// share one 4 MB block, so if the kernel's cost scales with the block rather
+// than the range, a burst of recompilation after LuaJIT discards its traces
+// would cost far more here than upstream ever paid. These counters say
+// whether that is true instead of leaving it a theory.
+static unsigned int      g1r_alloc_ok = 0;
+static unsigned int      g1r_alloc_fail = 0;
+
+
+void g1r_jit_note_alloc(int ok)
+{
+	if (ok) g1r_alloc_ok++; else g1r_alloc_fail++;
+}
+
+// --- frame timing ---------------------------------------------------------
+//
+// The stalls survive with no JIT tuning and no instrumentation, so they are
+// real and none of the earlier theories explain them. This records them
+// instead of guessing again, and it is built to not become the bug it is
+// measuring: the per-frame path is a clock read, a subtract and a compare,
+// with NO file I/O. A line is appended only when a frame has already taken
+// over a quarter of a second - at which point a few ms of fopen is noise
+// against the stall itself - and those are rare by definition.
+//
+// What each line answers: how long the freeze was, and whether the JIT was
+// busy across it. g1r_alloc_ok counts mcode areas handed out, so a jump in it
+// either side of a slow frame means LuaJIT threw its traces away and
+// recompiled - which would implicate the compiler. A slow frame with no
+// change in that number means the time went somewhere else entirely, and the
+// JIT is exonerated.
+#define G1R_SLOW_FRAME_US 250000
+
+static SceUInt64    g1r_frame_prev = 0;
+static unsigned int g1r_frame_no = 0;
+static unsigned int g1r_slow_seen = 0;
+static unsigned int g1r_alloc_at_last_slow = 0;
+
+void g1r_frame_tick(void)
+{
+	SceUInt64 now = sceKernelGetProcessTimeWide();
+	SceUInt64 prev = g1r_frame_prev;
+	g1r_frame_prev = now;
+	g1r_frame_no++;
+	if (prev == 0)
+		return;
+
+	SceUInt64 dt = now - prev;
+	if (dt < G1R_SLOW_FRAME_US)
+		return;
+
+	// Cap the file so a pathological run cannot fill the card.
+	if (++g1r_slow_seen > 200)
+		return;
+
+	FILE *f = fopen("ux0:data/g1r-frames.txt", "a");
+	if (!f)
+		return;
+	if (g1r_slow_seen == 1)
+		fprintf(f, "frame  at(s)  stall(ms)  mcodeAreas (+since last)  allocFail\n");
+	fprintf(f, "%6u %6.1f %9.0f %6u %+6d %10u\n",
+		g1r_frame_no, now / 1000000.0, dt / 1000.0,
+		g1r_alloc_ok, (int) g1r_alloc_ok - (int) g1r_alloc_at_last_slow,
+		g1r_alloc_fail);
+	g1r_alloc_at_last_slow = g1r_alloc_ok;
+	fclose(f);
+}
+
+
+static SceUID g1r_heap_memblock;
+static unsigned int g1r_heap_size;
+static char *g1r_heap_base, *g1r_heap_end, *g1r_heap_cur;
+static SceKernelLwMutexWork g1r_sbrk_mutex;
+
+static void g1r_jit_pool_reserve(void)
+{
+	SceUID uid = sceKernelAllocMemBlockForVM("LuaJIT mcode pool",
+		LOVE_VITA_JIT_POOL_MB * 1024 * 1024);
+	if (uid < 0)
+	{
+		g1r_jit_pool_err = uid;
+		return;
+	}
+	void *p = NULL;
+	int res = sceKernelGetMemBlockBase(uid, &p);
+	if (res < 0)
+	{
+		g1r_jit_pool_err = res;
+		sceKernelFreeMemBlock(uid);
+		return;
+	}
+	// Open the VM domain once and leave it open, so the pool is writable and
+	// executable for the whole run. LuaJIT would otherwise flip it around
+	// every trace, and sceKernelOpenVMDomain/CloseVMDomain act on the entire
+	// process: with LOVE's audio workers each compiling their own traces, the
+	// toggles interleave and one of them fails, which LuaJIT reports as
+	// "runtime code generation failed, restricted kernel?". lj_mcode.c builds
+	// with LUAJIT_UNPROTECT_MCODE so nothing toggles it again.
+	int opened = sceKernelOpenVMDomain();
+	if (opened < 0)
+	{
+		g1r_jit_pool_err = opened;
+		sceKernelFreeMemBlock(uid);
+		return;
+	}
+	g1r_jit_pool_mutex_ok =
+		sceKernelCreateLwMutex(&g1r_jit_pool_mutex, "jit pool", 0, 0, 0) >= 0;
+	g1r_jit_pool_uid = uid;
+	g1r_jit_pool_base = p;
+	g1r_jit_pool_size = LOVE_VITA_JIT_POOL_MB * 1024 * 1024;
+}
+
+void *_sbrk_r(struct _reent *reent, ptrdiff_t incr)
+{
+	if (sceKernelLockLwMutex(&g1r_sbrk_mutex, 1, 0) < 0)
+		goto fail;
+	if (!g1r_heap_base || g1r_heap_cur + incr >= g1r_heap_end)
+	{
+		sceKernelUnlockLwMutex(&g1r_sbrk_mutex, 1);
+fail:
+		reent->_errno = ENOMEM;
+		return (void *) -1;
+	}
+	{
+		char *prev = g1r_heap_cur;
+		g1r_heap_cur += incr;
+		sceKernelUnlockLwMutex(&g1r_sbrk_mutex, 1);
+		return (void *) prev;
+	}
+}
+
+void _init_vita_heap(void)
+{
+	if (sceKernelCreateLwMutex(&g1r_sbrk_mutex, "sbrk mutex", 0, 0, 0) < 0)
+		goto failure;
+
+	// Before the heap, while the only thing allocated is our own module.
+	g1r_jit_pool_reserve();
+
+	g1r_heap_size = (unsigned int) _newlib_heap_size_user;
+	g1r_heap_memblock = sceKernelAllocMemBlock("Newlib heap", 0x0c20d060,
+		g1r_heap_size, 0);
+	if (g1r_heap_memblock < 0)
+		goto failure;
+	if (sceKernelGetMemBlockBase(g1r_heap_memblock, (void **) &g1r_heap_base) < 0)
+		goto failure;
+	g1r_heap_end = g1r_heap_base + g1r_heap_size;
+	g1r_heap_cur = g1r_heap_base;
+	return;
+failure:
+	g1r_heap_memblock = 0;
+	g1r_heap_base = 0;
+	g1r_heap_cur = 0;
+}
+
+void _free_vita_heap(void)
+{
+	sceKernelDeleteLwMutex(&g1r_sbrk_mutex);
+	sceKernelFreeMemBlock(g1r_heap_memblock);
+	g1r_heap_memblock = 0;
+	g1r_heap_base = 0;
+	g1r_heap_cur = 0;
+}
+
+unsigned int _get_vita_heap_size(void)
+{
+	return g1r_heap_size;
+}
