-/* -- MCode area allocation ----------------------------------------------- */
-
-#if LJ_64
-#define mcode_validptr(p)	(p)
-#else
-#define mcode_validptr(p)	((p) && (uintptr_t)(p) < 0xffff0000)
-#endif
-
-#ifdef LJ_TARGET_JUMPRANGE
-
-/* Get memory within relative jump distance of our code in 64 bit mode. */
-static void *mcode_alloc(jit_State *J, size_t sz)
-{
-  /* Target an address in the static assembler code (64K aligned).
-  ** Try addresses within a distance of target-range/2+1MB..target+range/2-1MB.
-  ** Use half the jump range so every address in the range can reach any other.
-  */
-#if LJ_TARGET_MIPS
-  /* Use the middle of the 256MB-aligned region. */
-  uintptr_t target = ((uintptr_t)(void *)lj_vm_exit_handler &
-		      ~(uintptr_t)0x0fffffffu) + 0x08000000u;
-#else
-  uintptr_t target = (uintptr_t)(void *)lj_vm_exit_handler & ~(uintptr_t)0xffff;
-#endif
-  const uintptr_t range = (1u << (LJ_TARGET_JUMPRANGE-1)) - (1u << 21);
-  /* First try a contiguous area below the last one. */
-  uintptr_t hint = J->mcarea ? (uintptr_t)J->mcarea - sz : 0;
-  int i;
-  /* Limit probing iterations, depending on the available pool size. */
-  for (i = 0; i < LJ_TARGET_JUMPRANGE; i++) {
-    if (mcode_validptr(hint)) {
-      void *p = mcode_alloc_at(J, hint, sz, MCPROT_GEN);
-
-      if (mcode_validptr(p) &&
-	  ((uintptr_t)p + sz - target < range || target - (uintptr_t)p < range))
-	return p;
-      if (p) mcode_free(J, p, sz);  /* Free badly placed area. */
-    }
-    /* Next try probing 64K-aligned pseudo-random addresses. */
-    do {
-      hint = lj_prng_u64(&J2G(J)->prng) & ((1u<<LJ_TARGET_JUMPRANGE)-0x10000);
-    } while (!(hint + sz < range+range));
-    hint = target + hint - range;
-  }
-  lj_trace_err(J, LJ_TRERR_MCODEAL);  /* Give up. OS probably ignores hints? */
-  return NULL;
-}
-
-#else
-
-/* All memory addresses are reachable by relative jumps. */
-static void *mcode_alloc(jit_State *J, size_t sz)
-{
-#if defined(__OpenBSD__) || defined(__NetBSD__) || LJ_TARGET_UWP
-  /* Allow better executable memory allocation for OpenBSD W^X mode. */
-  void *p = mcode_alloc_at(J, 0, sz, MCPROT_RUN);
-  if (p && mcode_setprot(p, sz, MCPROT_GEN)) {
-    mcode_free(J, p, sz);
-    return NULL;
-  }
-  return p;
-#else
-  return mcode_alloc_at(J, 0, sz, MCPROT_GEN);
-#endif
-}
-
-#endif
-
-/* -- MCode area management ----------------------------------------------- */
-
-/* Allocate a new MCode area. */
-static void mcode_allocarea(jit_State *J)
-{
-  MCode *oldarea = J->mcarea;
-  size_t sz = (size_t)J->param[JIT_P_sizemcode] << 10;
-  sz = (sz + LJ_PAGESIZE-1) & ~(size_t)(LJ_PAGESIZE - 1);
-  J->mcarea = (MCode *)mcode_alloc(J, sz);
-  J->szmcarea = sz;
-  J->mcprot = MCPROT_GEN;
-  J->mctop = (MCode *)((char *)J->mcarea + J->szmcarea);
-  J->mcbot = (MCode *)((char *)J->mcarea + sizeof(MCLink));
-  ((MCLink *)J->mcarea)->next = oldarea;
-  ((MCLink *)J->mcarea)->size = sz;
-  J->szallmcarea += sz;
-  J->mcbot = (MCode *)lj_err_register_mcode(J->mcarea, sz, (uint8_t *)J->mcbot);
-}
-
-/* Free all MCode areas. */
-void lj_mcode_free(jit_State *J)
-{
-  MCode *mc = J->mcarea;
-  J->mcarea = NULL;
-  J->szallmcarea = 0;
-  while (mc) {
-    MCode *next = ((MCLink *)mc)->next;
-    size_t sz = ((MCLink *)mc)->size;
-    lj_err_deregister_mcode(mc, sz, (uint8_t *)mc + sizeof(MCLink));
-    mcode_free(J, mc, sz);
-    mc = next;
-  }
-}
-
-/* -- MCode transactions -------------------------------------------------- */
-
-/* Reserve the remainder of the current MCode area. */
-MCode *lj_mcode_reserve(jit_State *J, MCode **lim)
-{
-  if (!J->mcarea)
-    mcode_allocarea(J);
-  else
-    mcode_protect(J, MCPROT_GEN);
-  *lim = J->mcbot;
-  return J->mctop;
-}
-
-/* Commit the top part of the current MCode area. */
-void lj_mcode_commit(jit_State *J, MCode *top)
-{
-  J->mctop = top;
-  mcode_protect(J, MCPROT_RUN);
-}
-
-/* Abort the reservation. */
-void lj_mcode_abort(jit_State *J)
-{
-  if (J->mcarea)
-    mcode_protect(J, MCPROT_RUN);
-}
-
-/* Set/reset protection to allow patching of MCode areas. */
-MCode *lj_mcode_patch(jit_State *J, MCode *ptr, int finish)
-{
-  if (finish) {
-#if LUAJIT_SECURITY_MCODE
-    if (J->mcarea == ptr)
-      mcode_protect(J, MCPROT_RUN);
-#ifdef LUAJIT_PSP2PROTECT_MCODE
-    /* Restore previous state of the current (top) MCode area */
-    else if (LJ_UNLIKELY(mcode_setprot(NULL, 0, J->mcprot)))
-#else
-    else if (LJ_UNLIKELY(mcode_setprot(ptr, ((MCLink *)ptr)->size, MCPROT_RUN)))
-#endif
-      mcode_protfail(J);
-#endif
-    return NULL;
-  } else {
-    MCode *mc = J->mcarea;
-    /* Try current area first to use the protection cache. */
-    if (ptr >= mc && ptr < (MCode *)((char *)mc + J->szmcarea)) {
-#if LUAJIT_SECURITY_MCODE
-      mcode_protect(J, MCPROT_GEN);
-#endif
-      return mc;
-    }
-    /* Otherwise search through the list of MCode areas. */
-    for (;;) {
-      mc = ((MCLink *)mc)->next;
-      lj_assertJ(mc != NULL, "broken MCode area chain");
-      if (ptr >= mc && ptr < (MCode *)((char *)mc + ((MCLink *)mc)->size)) {
-#if LUAJIT_SECURITY_MCODE
-	if (LJ_UNLIKELY(mcode_setprot(mc, ((MCLink *)mc)->size, MCPROT_GEN)))
-	  mcode_protfail(J);
-#endif
-	return mc;
-      }
-    }
-  }
-}
-
-/* Limit of MCode reservation reached. */
-void lj_mcode_limiterr(jit_State *J, size_t need)
-{
-  size_t sizemcode, maxmcode;
-  lj_mcode_abort(J);
-  sizemcode = (size_t)J->param[JIT_P_sizemcode] << 10;
-  sizemcode = (sizemcode + LJ_PAGESIZE-1) & ~(size_t)(LJ_PAGESIZE - 1);
-  maxmcode = (size_t)J->param[JIT_P_maxmcode] << 10;
-  if ((size_t)need > sizemcode)
-    lj_trace_err(J, LJ_TRERR_MCODEOV);  /* Too long for any area. */
-  if (J->szallmcarea + sizemcode > maxmcode)
-    lj_trace_err(J, LJ_TRERR_MCODEAL);
-  mcode_allocarea(J);
-  lj_trace_err(J, LJ_TRERR_MCODELM);  /* Retry with new area. */
-}
-
-#endif
+/*
+** Machine code management.
+** Copyright (C) 2005-2022 Mike Pall. See Copyright Notice in luajit.h
+*/
+
+#define lj_mcode_c
+#define LUA_CORE
+
+#include "lj_obj.h"
+#if LJ_HASJIT
+#include "lj_gc.h"
+#include "lj_err.h"
+#include "lj_jit.h"
+#include "lj_mcode.h"
+#include "lj_trace.h"
+#include "lj_dispatch.h"
+#include "lj_prng.h"
+#endif
+#if LJ_HASJIT || LJ_HASFFI
+#include "lj_vm.h"
+#endif
+
+/* -- OS-specific functions ----------------------------------------------- */
+
+#if LJ_HASJIT || LJ_HASFFI
+
+/* Define this if you want to run LuaJIT with Valgrind. */
+#ifdef LUAJIT_USE_VALGRIND
+#include <valgrind/valgrind.h>
+#endif
+
+#if LJ_TARGET_IOS
+void sys_icache_invalidate(void *start, size_t len);
+#endif
+
+#if LJ_TARGET_PSP2
+#include <psp2/kernel/sysmem.h>
+/* The executable pool love.cpp reserves before the newlib heap exists, and
+** its block uid. Declared here because lj_mcode_sync needs the uid too. */
+extern void *g1r_jit_pool_base;   /* NULL when the pool was not reserved */
+extern unsigned int g1r_jit_pool_size;
+extern int g1r_jit_pool_uid;
+extern void g1r_jit_pool_lock(void);
+extern void g1r_jit_pool_unlock(void);
+/* Allocation counter only: it is a few adds and never touches the card. */
+extern void g1r_jit_note_alloc(int ok);
+#endif
+
+/* Synchronize data/instruction cache. */
+void lj_mcode_sync(void *start, void *end)
+{
+#ifdef LUAJIT_USE_VALGRIND
+  VALGRIND_DISCARD_TRANSLATIONS(start, (char *)end-(char *)start);
+#endif
+#if LJ_TARGET_PSP2
+  /* This is the instruction-cache invalidation, and getting the block wrong
+  ** means it silently does not happen - the CPU then executes whatever was in
+  ** the icache for those addresses. The original lookup rounds `start` down to
+  ** a 1 MB boundary and asks the kernel which block lives there, which worked
+  ** only because every mcode area used to be its own VM block and those are
+  ** 1 MB granular, so the rounded address was always exactly the block base.
+  ** Areas now come out of one 4 MB pool, so anything past the pool's first
+  ** megabyte rounds to an address that is inside the block but is not its
+  ** base; the lookup fails, SyncVMDomain gets a negative uid, and nothing is
+  ** flushed. That is load-dependent by construction - it survives until
+  ** enough code has been compiled to cross 1 MB - which is why a small probe
+  ** passed and the game died once the audio workers started compiling too.
+  ** The assertion that would have caught it is the one upstream commented out
+  ** as "Removed Assertion". We know the pool's uid, so just use it. */
+  SceUID block;
+  if (g1r_jit_pool_base &&
+      (char *)start >= (char *)g1r_jit_pool_base &&
+      (char *)start < (char *)g1r_jit_pool_base + g1r_jit_pool_size) {
+    block = g1r_jit_pool_uid;
+  } else {
+    void *base = (void *)((uintptr_t)start & ~(uintptr_t)0xFFFFF);
+    block = sceKernelFindMemBlockByAddr(base, 0);
+  }
+  /* Deliberately NOT instrumented. Timing this cost two syscalls on every
+  ** sync and rewrote a stats file every 256 of them; startup alone does
+  ** ~25,000 syncs, so that was ~98 fopen/fclose cycles to the memory card
+  ** before the launcher could appear, and it is why the launcher stopped
+  ** showing up at all. The measurement it bought is already in hand and was
+  ** conclusive - 14.7 us mean, 128 us worst - so there is nothing left to
+  ** learn here and no reason to keep paying for it. */
+  if (block >= 0)
+    sceKernelSyncVMDomain(block, start, (char *)end-(char *)start);
+#elif LJ_TARGET_X86ORX64
+  UNUSED(start); UNUSED(end);
+#elif LJ_TARGET_IOS
+  sys_icache_invalidate(start, (char *)end-(char *)start);
+#elif LJ_TARGET_PPC
+  lj_vm_cachesync(start, end);
+#elif defined(__GNUC__) || defined(__clang__)
+  __clear_cache(start, end);
+#else
+#error "Missing builtin to flush instruction cache"
+#endif
+}
+
+#endif
+
+#if LJ_HASJIT
+
+#if LJ_TARGET_PSP2
+
+/*
+** The original port flipped the VM domain between writable and executable
+** around every trace, and left the race as NYI ("there's only a dirty hack on
+** lj_mcode_patch"). That race is not theoretical: sceKernelOpenVMDomain and
+** sceKernelCloseVMDomain take no argument and act on the whole process, while
+** LOVE runs several Lua states at once - the audio workers - each with its own
+** jit_State toggling the one domain. The single-threaded probe was fine; the
+** full game died on the first trace with "runtime code generation failed,
+** restricted kernel?", which is mcode_setprot returning an error.
+**
+** So do not toggle at all. love.cpp opens the domain once, before the heap
+** exists, and never closes it, which leaves the pool both writable and
+** executable for the life of the process; mcode_setprot below then returns
+** success without touching anything. LuaJIT still calls it, and still tracks
+** J->mcprot, but every transition is a no-op and there is nothing left to
+** race over. This is LuaJIT's LUAJIT_SECURITY_MCODE=0 stance in effect - RWX
+** code pages - reached without changing the build-wide security level, which
+** on a homebrew-enabled console costs nothing worth having.
+*/
+#define LUAJIT_PSP2PROTECT_MCODE
+#define MCPROT_RX 0
+#define MCPROT_RWX 1
+
+static int mcode_setprot(void *p, size_t sz, int prot)
+{
+  UNUSED(p); UNUSED(sz);
+  if (g1r_jit_pool_base) return 0;  /* already open for good; never toggled */
+  if (MCPROT_RX == prot)
+    return sceKernelCloseVMDomain();
+  else
+    return sceKernelOpenVMDomain();
+}
+
+/*
+** Allocate from a pool reserved before the newlib heap exists.
+**
+** sceKernelAllocMemBlockForVM() takes no address argument, so the `hint` that
+** mcode_alloc() spends 25 iterations refining is discarded and the kernel
+** places each block after everything already allocated - which means after
+** the heap.  With love's 124 MB heap that is ~140 MB past the code segment,
+** far outside the +-14 MB that ARM relative branches reach, so every trace
+** ended in LJ_TRERR_MCODEAL ("failed to allocate mcode memory").  The kernel
+** also refuses VM blocks smaller than 1 MB, while LuaJIT asks for sizemcode
+** (32 KB by default), so the allocation failed on size alone as well.
+**
+** g1r_jit_pool_reserve() in love.cpp takes one MB-aligned VM block before
+** _init_vita_heap() creates the heap, so the pool lands a few MB from the
+** code and inside branch range.  Areas are carved out of it here, which fixes
+** the size problem too.  If the reservation failed the old path still runs,
+** so this is never worse than before.
+*/
+#define MCPOOL_PAGE	4096
+#define MCPOOL_MAXPAGES	16384		/* covers a 64 MB pool */
+
+/* Several Lua states allocate from this one pool (LOVE's audio workers each
+** have their own jit_State), so the bitmap is shared mutable state and the
+** scan below has to be exclusive or two threads hand out the same pages. */
+static uint8_t mcpool_used[MCPOOL_MAXPAGES];
+
+static void *mcode_alloc_at(jit_State *J, uintptr_t hint, size_t sz, int prot)
+{
+  void *p = NULL;
+  UNUSED(hint);
+  if (g1r_jit_pool_base) {
+    unsigned int npages = g1r_jit_pool_size / MCPOOL_PAGE;
+    unsigned int need = (unsigned int)((sz + MCPOOL_PAGE-1) / MCPOOL_PAGE);
+    unsigned int i, j;
+    if (npages > MCPOOL_MAXPAGES) npages = MCPOOL_MAXPAGES;
+    g1r_jit_pool_lock();
+    for (i = 0; need && i + need <= npages; i++) {
+      for (j = 0; j < need && !mcpool_used[i+j]; j++) ;
+      if (j == need) {
+	for (j = 0; j < need; j++) mcpool_used[i+j] = 1;
+	p = (void *)((char *)g1r_jit_pool_base + (size_t)i * MCPOOL_PAGE);
+	break;
+      }
+      i += j;  /* Skip the run that just failed. */
+    }
+    if (p && mcode_setprot(p, sz, prot)) {
+      for (j = 0; j < need; j++) mcpool_used[i+j] = 0;
+      p = NULL;
+    }
+    g1r_jit_pool_unlock();
+  } else {
+    int fail;
+    SceUID block = sceKernelAllocMemBlockForVM("LuaJITCodeMemBlock", sz);
+    if (block < 0) {
+      fail = 1;
+    } else if (LJ_UNLIKELY(sceKernelGetMemBlockBase(block, &p) < 0)) {
+      sceKernelFreeMemBlock(block);
+      fail = 1;
+    } else if (mcode_setprot(p, sz, prot)) {
+      sceKernelFreeMemBlock(block);
+      fail = 1;
+    } else {
+      fail = 0;
+    }
+    if (fail) p = NULL;
+  }
+  g1r_jit_note_alloc(p != NULL);
+  if (!p && !hint) lj_trace_err(J, LJ_TRERR_MCODEAL);
+  return p;
+}
+
+static void mcode_free(jit_State *J, void *p, size_t sz)
+{
+  SceUID block;
+  UNUSED(J);
+  if (g1r_jit_pool_base &&
+      (char *)p >= (char *)g1r_jit_pool_base &&
+      (char *)p < (char *)g1r_jit_pool_base + g1r_jit_pool_size) {
+    unsigned int i = (unsigned int)(((char *)p - (char *)g1r_jit_pool_base) /
+				    MCPOOL_PAGE);
+    unsigned int need = (unsigned int)((sz + MCPOOL_PAGE-1) / MCPOOL_PAGE);
+    g1r_jit_pool_lock();
+    while (need-- && i < MCPOOL_MAXPAGES) mcpool_used[i++] = 0;
+    g1r_jit_pool_unlock();
+    return;
+  }
+  block = sceKernelFindMemBlockByAddr((void *)((uintptr_t)p & ~(uintptr_t)0xFFFFF), 0);
+  /* Removed Assertion */
+  sceKernelFreeMemBlock(block);
+}
